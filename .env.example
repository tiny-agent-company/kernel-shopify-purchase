# Kernel: the API key the browser is created with (dashboard.onkernel.com → api keys).
KERNEL_API_KEY=

# Agentcard: your organization's production client credentials (app.agentcard.sh → Settings → Developers → Credentials).
AGENTCARD_CLIENT_ID=
AGENTCARD_CLIENT_SECRET=
# The user the purchase is made for. They need a card in the Vault; see https://docs.agentcard.sh/vault/adding-a-card
AGENTCARD_USER_ID=

# What to buy: a product page on a Shopify store with guest checkout.
PRODUCT_URL=https://www.goodandbeautiful.com/products/high-school-biology-answer-key
# The merchant the approval names: the store's hostname.
MERCHANT=www.goodandbeautiful.com

# The buyer on the checkout form. The email receives the receipt; avoid one with a Shop Pay account (its code prompt covers the page).
BUYER_EMAIL=
BUYER_FIRST=
BUYER_LAST=
BUYER_ADDRESS1=
BUYER_ADDRESS2=
BUYER_CITY=
BUYER_STATE=California
BUYER_ZIP=

# The placeholder card the agent types; any of Stripe's published test cards (https://docs.stripe.com/testing). The real card never enters the browser.
PLACEHOLDER_CARD_NUMBER=4242424242424242

# How the approval link reaches the user: a shell command run with the link in $APPROVAL_URL. Without it the link is only printed.
# APPROVAL_LINK_COMMAND=./notify-user.sh "$APPROVAL_URL"

# buy-local.mjs: chrome launches the Google Chrome on this machine; unset launches Playwright's Chromium (npx playwright-core install chromium).
BROWSER_CHANNEL=chrome
